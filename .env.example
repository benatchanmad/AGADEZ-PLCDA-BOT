# ==============================================================================
# AGADEZ PLCDA BOT - Plateforme Anti-Désinformation & Rumeurs (Région d'Agadez)
# Configuration de l'environnement
# ==============================================================================

# Nom et URL de l'application
NEXT_PUBLIC_APP_NAME="AGADEZ PLCDA BOT"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# Clé de chiffrement des sessions et tokens JWT (Générer une clé sécurisée en production)
JWT_SECRET="agadez-plcda-super-secret-jwt-key-2026-anti-rumeur-paix-securite"

# Base de données PostgreSQL (Production / Staging)
# Format : postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Pour le développement local rapide sans serveur PostgreSQL externe : file:./dev.db
DATABASE_URL="file:./dev.db"

# Meta WhatsApp Business Cloud API
# En mode DEMO (WHATSAPP_DEMO_MODE=true), le simulateur interactif intégré fonctionne
# directement sans requérir de clés réelles Meta.
WHATSAPP_DEMO_MODE="true"
WHATSAPP_VERIFY_TOKEN="agadez_plcda_webhook_verify_token_2026"
WHATSAPP_ACCESS_TOKEN="EAAG..."
WHATSAPP_PHONE_NUMBER_ID="109876543210987"
WHATSAPP_BUSINESS_ACCOUNT_ID="123456789012345"
WHATSAPP_API_VERSION="v20.0"

# Stockage des fichiers & preuves (local ou S3 compatible : AWS, MinIO, Scaleway)
STORAGE_DRIVER="local"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_REGION="eu-west-3"
S3_BUCKET_NAME="agadez-plcda-preuves"
S3_ENDPOINT=""

# Région par défaut pour la géolocalisation
DEFAULT_REGION="Agadez"
DEFAULT_COUNTRY="Niger"
